{
  "name": "@limccn/create-agent-plugin",
  "version": "0.1.0",
  "description": "Scaffold an agent plugin (multi-agent installer, MCP tools, hooks) from a battle-tested template — 22 agent targets in minutes.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limccn/create-agent-plugin.git"
  },
  "homepage": "https://github.com/limccn/create-agent-plugin",
  "bugs": {
    "url": "https://github.com/limccn/create-agent-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-agent-plugin": "dist/generator.js"
  },
  "files": [
    "dist/",
    "src/framework/",
    "src/plugin/",
    "src/assets/",
    "assets/",
    "src/generator/",
    "src/cli-entry.ts",
    "src/hook-entry.ts",
    "src/dsh-plugin.ts",
    "tests/",
    "build.mjs",
    "tsconfig.json",
    ".gitignore",
    "skills/",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    "marketplace.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "scaffold",
    "plugin",
    "agent",
    "mcp",
    "claude-code",
    "codex",
    "agent-plugins",
    "agent-skills",
    "create-agent-plugin"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "verify": "npm run build && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
